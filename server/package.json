{
  "name": "nexus-server",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "worker": "tsx src/worker.ts",
    "worker:prod": "node dist/worker.js",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/import.ts --demo",
    "import": "tsx src/import.ts",
    "test": "tsx --test test/*.test.ts",
    "test:integration": "tsx --test test/integration.ts",
    "eval:rag": "tsx src/evaluate.ts"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.130",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/swagger": "^12.0.5",
    "ai": "^7.0.157",
    "argon2": "^0.44",
    "bullmq": "^6.5.1",
    "cookie-parser": "^1",
    "dotenv": "^17",
    "drizzle-orm": "^0.45.4",
    "helmet": "^8",
    "ioredis": "^5",
    "nodemailer": "^10.3.1",
    "postgres": "^3",
    "reflect-metadata": "^0.2",
    "rxjs": "^7",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1",
    "@types/express": "^5",
    "@types/node": "^24",
    "@types/nodemailer": "^7",
    "tsx": "^4",
    "typescript": "^5.9"
  }
}
